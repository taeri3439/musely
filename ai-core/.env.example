# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
#   cmd:        copy .env.example .env
#   PowerShell: Copy-Item .env.example .env
#
# LLM 키는 ai-core의 .env에만 있고 Spring Boot는 모른다(빌드 플랜 04절).

APP_ENV=local
LOG_LEVEL=INFO

# --- job (ai-core 플랜 04절) ---
# 상한이 없으면 LLM이 먹통일 때 job이 영원히 RUNNING으로 남고 프론트가 무한 폴링한다.
JOB_TIMEOUT_SECONDS=30
JOB_TTL_MINUTES=30

# --- LLM · 임베딩 (2주차부터 사용. mock 서버는 읽지 않는다) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# Anthropic은 임베딩 API가 없다. 임베딩은 openai | gemini.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# --- 벡터 스토어 (2주차부터) ---
# chroma | qdrant. 선택 근거는 README의 "데이터 스키마 메모" 참고.
VECTOR_STORE=chroma
CHROMA_PATH=./chroma
QDRANT_URL=http://localhost:6333
